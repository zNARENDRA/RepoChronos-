APP_NAME=RepoChronos
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
DB_CONNECTION=pgsql
DB_PERSISTENT=true
# Supabase session pooler hostname and postgres.PROJECT_REF username from Connect.
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
# Optional CA certificate bundle path for PostgreSQL TLS verification.
DB_SSLROOTCERT=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
GITHUB_TOKEN=
# Optional CA bundle path for PHP installations without a configured trust store.
GITHUB_CA_BUNDLE=
PYTHON_BINARY=python
COMPLEXITY_THRESHOLD=5
ALLOW_SAMPLE_DATA=false
