<div class="kicker"><span class="dash"></span> CHANGE LEDGER</div><h1>Change history</h1><p class="lead">Trace each file revision to its author and commit.</p>
<section class="panel"><form class="inline" method="get"><label>File path or commit prefix<input name="q" value="<%= q %>" placeholder="src/router.js"></label><label>Developer<select name="author"><option value="0">All developers</option><% for(const p of people){ %><option value="<%= p.id %>" <%= developer===p.id?'selected':'' %>><%= p.display_name %></option><% } %></select></label><button>Filter history</button><a class="link" href="<%= base %>/history">Clear</a></form></section>
<section class="panel table-panel"><div class="panel-head"><h2>File revisions</h2><span class="pill">Page <%= page %></span></div><div class="table-scroll"><table><thead><tr><th>File / commit</th><th>Author</th><th>Change</th><th>Lines</th><th>Authored (UTC)</th></tr></thead><tbody>
<% for(const h of items){ %><tr><td><b class="path"><%= h.path %></b><% if(h.previous_path){ %><small>from <%= h.previous_path %></small><% } %><small><span class="sha"><%= short(h.sha) %></span> <%= h.message.split('\n')[0] %></small></td><td><%= h.display_name %></td><td><span class="pill"><%= h.kind %></span></td><td class="nowrap"><code class="positive">+<%= h.additions %></code> <code class="negative">−<%= h.deletions %></code></td><td class="date"><%= dt(h.authored_at) %></td></tr><% } %></tbody></table></div><% if(!items.length){ %><p class="empty">No file revisions match these filters.</p><% } %>
<div class="actions paging"><% for(const [enabled,p,label] of [[page>1,page-1,'← Previous'],[more,page+1,'Next →']]){ if(enabled){ %><a class="button" href="?<%= new URLSearchParams({q,author:developer,page:p}).toString() %>"><%= label %></a><% }} %></div></section>
