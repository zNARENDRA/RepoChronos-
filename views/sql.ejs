<div class="kicker"><span class="dash"></span> DATABASE EXPLORER</div><h1>SQL workbench</h1><p class="lead">Run a prepared report against this repository and inspect the actual SQL and result rows.</p>
<section class="panel"><form class="inline"><label>Report<select name="report"><% for(const [i,r] of reports.entries()){ %><option value="<%= i %>" <%= report===r?'selected':'' %>><%= r.name %></option><% } %></select></label><button class="primary">Run query</button></form><p><%= report.about %></p><div class="sql-box"><div><i></i> PostgreSQL <span>$1 = <%= repo.id %></span></div><pre><code><%= report.sql %></code></pre></div></section>
<section class="panel table-panel"><div class="panel-head"><h2>Result set</h2><span class="pill"><%= result.rowCount %> rows</span></div><div class="table-scroll"><table><thead><tr><% for(const f of result.fields){ %><th><%= f.name %></th><% } %></tr></thead><tbody><% for(const r of result.rows){ %><tr><% for(const f of result.fields){ const v=r[f.name]; %><td><%= v instanceof Date?dt(v):v??'—' %></td><% } %></tr><% } %></tbody></table></div><% if(!result.rowCount){ %><p class="empty">The query returned no rows for this repository.</p><% } %></section>
