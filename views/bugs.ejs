<div class="kicker"><span class="dash"></span> ISSUE LEDGER</div>
<% if(section==='bugs'){ %><h1>Bug tracker</h1><p class="lead">Follow a report through assignment to its fixing commit.</p>
<section class="panel"><h2>Report a bug</h2><form method="post" class="form-stack"><div class="form-pair"><label>Title<input name="title" maxlength="160" placeholder="What went wrong?" required></label><label>Reported by<input name="reporter" maxlength="80" placeholder="Your name" required></label></div><label>Description <span class="optional">(optional)</span><textarea name="details" rows="2" maxlength="4000" placeholder="Steps to reproduce or expected behavior"></textarea></label><div><button class="primary">Report bug</button></div></form></section>
<section class="panel table-panel"><div class="panel-head"><h2>Bug reports</h2><span class="pill"><%= bugs.length %> total</span></div><div class="table-scroll"><table><thead><tr><th>Report</th><th>Status</th><th>Assignee</th><th>Time to fix</th></tr></thead><tbody><% for(const b of bugs){ %><tr><td><a class="link" href="<%= base %>/bugs/<%= b.id %>">#<%= b.id %> · <%= b.title %></a><small><%= b.reporter %> · <%= dt(b.reported_at) %></small></td><td><span class="pill <%= b.status.toLowerCase() %>"><%= b.status %></span></td><td><%= b.assignee || 'Unassigned' %></td><td><%= b.fixed_at?duration(b.resolution_seconds):'—' %></td></tr><% } %></tbody></table></div><% if(!bugs.length){ %><p class="empty">No reports yet. Record the first bug above.</p><% } %></section>
<% } else { %><a class="link" href="<%= base %>/bugs">← All reports</a><h1 class="bug-title"><%= bug.title %></h1><p class="lead">Report #<%= bug.id %> · <%= bug.reporter %> · <%= dt(bug.reported_at) %> UTC</p>
<section class="panel"><div class="panel-head"><h2>Report details</h2><span class="pill <%= bug.status.toLowerCase() %>"><%= bug.status %></span></div><p class="description"><%= bug.details || 'No description provided.' %></p>
<div class="stats-line"><span>Assignee <b><%= bug.assignee || 'Unassigned' %></b></span><span>Time to fix <b><%= bug.fixed_at?duration(bug.resolution_seconds):'—' %></b></span><% if(bug.fix_sha){ %><span>Fix <a class="sha" href="<%= base %>/history?q=<%= bug.fix_sha %>"><%= short(bug.fix_sha) %></a></span><% } %></div></section>
<% if(!bug.fixed_at){ %><section class="panel"><h2>Record an event</h2><form method="post" class="inline"><input type="hidden" name="kind" value="assigned"><label>Assign to developer<select name="target" required><option value="">Choose a contributor</option><% for(const p of people){ %><option value="<%= p.id %>"><%= p.display_name %></option><% } %></select></label><button>Assign</button></form>
<% if(bug.assignee){ %><form method="post" class="inline"><input type="hidden" name="kind" value="fixed"><label>Fixing commit<select name="target" required><option value="">Choose an imported commit</option><% for(const c of commits){ %><option value="<%= c.id %>"><%= short(c.sha) %> · <%= c.message.split('\n')[0] %></option><% } %></select></label><button class="primary">Mark fixed</button></form><% } %></section><% } %>
<section class="panel"><div class="overline">APPEND-ONLY</div><h2>Event timeline</h2><ol class="timeline"><li><b>Reported</b> by <%= bug.reporter %><small><%= dt(bug.reported_at) %> UTC</small></li><% for(const e of events){ %><li><% if(e.kind==='assigned'){ %><b>Assigned</b> to <%= e.display_name %><% }else{ %><b>Marked fixed</b> with <a class="sha" href="<%= base %>/history?q=<%= e.sha %>"><%= short(e.sha) %></a><% } %><small><%= dt(e.at) %> UTC</small></li><% } %></ol></section><% } %>
