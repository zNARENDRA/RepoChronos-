<div class="kicker"><span class="dash"></span> REPOSITORY ANALYTICS</div>
<div class="hero"><div><h1>Repository overview</h1><p>Activity, contributors, and code health for <strong><%= repo.full_name %></strong>.</p></div>
<a class="button primary" href="/repositories"><svg><use href="/icons.svg#plus"/></svg> Connect repository</a></div>
<% if(repo.source_key==='sample'){ %><div class="sample-tag"><i></i> SAMPLE REPOSITORY</div><% } %>
<div class="metrics"><% for(const [key,name,icon,color,detail,target] of [['commits','Commits','commit','green',totals.files+' tracked file paths','history'],['people','Contributors','people','blue','Distinct commit authors','history'],['warnings','Warnings','alert','amber','Stored complexity findings','analysis'],['bugs','Open bugs','bug','violet','Awaiting a linked fix','bugs']]){ %>
<a class="metric" href="<%= base %>/<%= target %>"><span class="metric-top"><span class="ico <%= color %>"><svg><use href="/icons.svg#<%= icon %>"/></svg></span><%= name %></span><strong><%= int(totals[key]) %></strong><small><%= detail %></small></a><% } %></div>
<div class="twocol"><section class="panel"><div class="panel-head"><div><span class="overline">ACTIVITY</span><h2>Commit trend</h2></div><span class="pill">14 days</span></div>
<p class="sub">Daily commits through the latest imported author date.</p>
<% const peak=Math.max(1,...days.map(d=>d.n)); %><div class="plot"><div class="axis"><span><%= peak %></span><span>0</span></div><div class="bars"><% for(const day of days){ %><div class="bar-slot" title="<%= day.label %> · <%= day.n %> commits"><div class="bar <%= day.n===peak?'peak':'' %>" style="height:<%= 100*day.n/peak %>%"></div></div><% } %></div></div>
<div class="chart-labels"><span><%= days[0].label %></span><span><%= days[6].label %></span><span><%= days[13].label %></span></div>
<details class="chart-data"><summary>Daily values</summary><p><%= days.map(d=>d.label+' · '+d.n).join('  /  ') %></p></details></section>
<section class="panel"><div class="panel-head"><div><span class="overline">PEOPLE</span><h2>Contributors</h2></div><svg class="faint"><use href="/icons.svg#people"/></svg></div>
<p class="sub">Ranked by imported commits.</p><% for(const [i,p] of people.entries()){ %><a class="person" href="<%= base %>/history?author=<%= p.id %>"><span class="avatar tint<%= i%4 %>"><%= initials(p.display_name) %></span><span class="person-main"><b><%= p.display_name %></b><span class="meter"><i style="width:<%= 100*p.commits/Math.max(1,people[0].commits) %>%"></i></span></span><code><%= p.commits %></code></a><% } if(!people.length){ %><p class="empty">Contributors appear after the first import.</p><% } %></section></div>
<section class="panel table-panel"><div class="panel-head"><div><span class="overline">LEDGER</span><h2>Recent commits</h2></div><a class="link" href="<%= base %>/history">View history →</a></div><div class="table-scroll"><table><thead><tr><th>Commit</th><th>Message</th><th>Author</th><th>Authored (UTC)</th></tr></thead><tbody><% for(const c of recent){ %><tr><td><a class="sha" href="<%= base %>/history?q=<%= short(c.sha) %>"><%= short(c.sha) %></a></td><td class="msg"><%= c.message.split('\n')[0] %></td><td><%= c.display_name %></td><td class="date"><%= dt(c.authored_at) %></td></tr><% } %></tbody></table></div><% if(!recent.length){ %><p class="empty">No commits imported yet.</p><% } %></section>
