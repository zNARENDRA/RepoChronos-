<div class="kicker"><span class="dash"></span> WORKSPACE</div><h1>Repositories</h1><p class="lead">Connect a GitHub repository or explore the built-in multi-developer sample.</p>
<section class="panel"><div class="overline">GITHUB IMPORT</div><h2>Connect repository</h2><p class="sub">Import 15 commits at a time from the default branch. Each batch keeps its exact snapshot.</p>
<form method="post" action="/connect" class="inline"><label>Repository URL or owner/name<input name="name" placeholder="octocat/Hello-World" required maxlength="200"></label><button class="primary">Connect &amp; import</button></form></section>
<section class="panel"><div class="panel-head"><div><span class="overline">DIRECTORY</span><h2>Connected repositories</h2></div><span class="pill"><%= repos.length %> total</span></div>
<% for(const r of repos){ const last=checkpoints.find(p=>p.repo_id===r.id); %><div class="repo-row"><div><span class="overline"><%= r.source_key==='sample'?'SAMPLE':'GITHUB' %></span><h3><a href="/r/<%= r.id %>/overview"><%= r.full_name %> ↗</a></h3><small><%= last?'Last import '+dt(last.imported_at)+' UTC · '+(last.more?'more history available':'snapshot complete'):r.source_key==='sample'?'Bundled examiner dataset':'Ready to import' %></small></div>
<% if(r.source_key!=='sample'){ %><div class="actions"><form method="post" action="/r/<%= r.id %>/import"><button>Sync latest</button></form><% if(last?.more){ %><form method="post" action="/r/<%= r.id %>/import"><input type="hidden" name="head" value="<%= last.head_sha %>"><button>Continue import</button></form><% } %></div><% } %></div><% } %>
<% if(!repos.some(r=>r.source_key==='sample')){ %><form method="post" action="/sample" class="repo-row"><div><h3>Fieldnotes sample</h3><small>18 commits, three developers, and a resolved bug. Available offline.</small></div><button>Load sample</button></form><% } %></section>
