APP_NAME=RepoChronos
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/var/www/repochronos/shared/supabase-ca.crt
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
PYTHON_BINARY=/var/www/repochronos/.venv/bin/python
COMPLEXITY_THRESHOLD=5
ALLOW_SAMPLE_DATA=false
GITHUB_TOKEN=
GITHUB_CA_BUNDLE=
